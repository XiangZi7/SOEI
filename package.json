{
  "name": "soei",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src *.ts *.mjs scripts/tauri.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "format": "prettier --write src vite.config.ts vitest.config.ts eslint.config.mjs scripts/tauri.mjs",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts eslint.config.mjs scripts/tauri.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.141",
    "@iconify/vue": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.5"
  }
}
